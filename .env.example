# System Configuration
ENVIRONMENT=dev # dev, paper, prod
LOG_LEVEL=INFO

# Database Configuration
# SQLite is used by default for local development. Postgres for production.
DATABASE_URL=sqlite:///./stock_agent.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_agent

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Alpha Vantage API Key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Korea Investment & Securities (KIS) API (한국투자증권)
# For real or paper trading
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_ACCOUNT_NO=your_kis_account_number_with_suffix # e.g. 12345678-01
KIS_CANO=your_kis_cano # First 8 digits of account number
KIS_ACNT_PRDT_CD=your_kis_product_code # Last 2 digits (usually 01)
KIS_URL=https://openapimts.koreainvestment.com:29443 # Real trading. For paper trading: https://openapi.koreainvestment.com:29443

# Notification Webhooks
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Trading Strategy Configurations
TRADING_UNIVERSE=005930,000660,035420 # Samsung Electronics, SK Hynix, NAVER
MAX_DAILY_ORDER_AMOUNT=5000000 # KRW
MAX_POSITION_RATIO=0.3 # Max 30% of portfolio per stock
RISK_STOP_LOSS_PCT=0.05 # Stop loss at -5%
RISK_TAKE_PROFIT_PCT=0.15 # Take profit at +15%
